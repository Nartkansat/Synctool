<UserControl x:Class="Synctool.Views.RegionalCampaignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Loaded="UserControl_Loaded"
             Background="#F8FAFC">
    <UserControl.Resources>
        <!-- Özel modern TextBox Stili (Görünürlük ve Kontrast Garantili) -->
        <Style x:Key="PremiumTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0284C7"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Özel Premium Mavi Buton Stili -->
        <Style x:Key="PrimaryGradientButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0284C7" Offset="0"/>
                                    <GradientStop Color="#0369A1" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.2" ShadowDepth="3" Color="#0284C7"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Özel İkincil Nötr Buton Stili -->
        <Style x:Key="SecondaryNeutralButton" TargetType="Button">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- JSON Buton Stili -->
        <Style x:Key="JsonOutlinedButton" TargetType="Button">
            <Setter Property="Foreground" Value="#0284C7"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1.5" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0F2FE"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════
             HEADER / BAŞLIK BÖLÜMÜ
             ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,20" Padding="24,20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F0F9FF" Offset="0"/>
                    <GradientStop Color="#FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.04" ShadowDepth="2" Color="#1E293B"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="52" Height="52" Background="#E0F2FE" CornerRadius="14">
                    <materialDesign:PackIcon Kind="MapMarker" Width="28" Height="28" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Bölgesel Kampanya Yönetimi" FontSize="22" FontWeight="Black" Foreground="#0F172A"/>
                    <TextBlock Text="Bölgeye özel ekstra ürün indirimlerini tanımlayın. Bu indirimler maliyet hesaplamalarında standart kampanyalara göre öncelikli uygulanır ve JSON ayar dosyasında saklanır." FontSize="13" Foreground="#475569" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="2" x:Name="BtnOpenJsonFile" Click="BtnOpenJsonFile_Click" Style="{StaticResource JsonOutlinedButton}" Height="42" Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CodeJson" Width="18" Height="18" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="JSON Konumunu Aç" Foreground="#0284C7" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             İÇERİK BÖLÜMÜ (SOL: FORM, SAĞ: LİSTE)
             ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SOL PANEL: ÜRÜN ARAMA VEYA KAMPANYA FORM -->
            <materialDesign:Card Grid.Column="0" UniformCornerRadius="16" Background="White" Margin="0,0,16,0" Padding="24">
                <materialDesign:Card.Effect>
                    <DropShadowEffect BlurRadius="15" Opacity="0.03" ShadowDepth="3" Color="#1E293B"/>
                </materialDesign:Card.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- BAŞLIK -->
                        <TextBlock Text="Bölgesel Kampanya Ekle / Düzenle" FontSize="17" FontWeight="Black" Foreground="#0F172A" Margin="0,0,0,18"/>

                        <!-- ÜRÜN ARAMA -->
                        <TextBlock Text="Sistemdeki Ürünlerden Ara &amp; Seç" FontSize="13" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <TextBox x:Name="TxtSearchProduct"
                                     Style="{StaticResource PremiumTextBox}"
                                     TextChanged="TxtSearchProduct_TextChanged"
                                     Height="44"/>
                            <TextBlock Text="Ürün Kodu veya Adı ile Ara..."
                                       IsHitTestVisible="False"
                                       Foreground="#94A3B8"
                                       FontSize="13"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearchProduct}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- ÜRÜN ARAMA SONUÇLARI LİSTESİ -->
                        <Border x:Name="BorderSearchResults" Visibility="Collapsed" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="10" Background="#FFFFFF" MaxHeight="200" Margin="0,4,0,16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Opacity="0.1" ShadowDepth="4" Color="#0284C7"/>
                            </Border.Effect>
                            <ListBox x:Name="LstSearchResults" SelectionChanged="LstSearchResults_SelectionChanged" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Background="White">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProductCode}" FontWeight="Black" FontSize="13" Foreground="#0284C7"/>
                                                <TextBlock Text="{Binding ProductName}" FontSize="12" FontWeight="Medium" Foreground="#334155" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Separator Background="#E2E8F0" Margin="0,10,0,16"/>

                        <!-- SEÇİLEN VEYA MANUEL ÜRÜN KODU -->
                        <TextBlock Text="Ürün Kodu *" FontSize="13" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <TextBox x:Name="TxtProductCode"
                                     Style="{StaticResource PremiumTextBox}"
                                     Height="44"/>
                            <TextBlock Text="Örn: 18325"
                                       IsHitTestVisible="False"
                                       Foreground="#94A3B8"
                                       FontSize="13"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtProductCode}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- ÜRÜN ADI -->
                        <TextBlock Text="Ürün Adı" FontSize="13" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <TextBox x:Name="TxtProductName"
                                     Style="{StaticResource PremiumTextBox}"
                                     Height="44"/>
                            <TextBlock Text="Örn: Buzdolabı X Model"
                                       IsHitTestVisible="False"
                                       Foreground="#94A3B8"
                                       FontSize="13"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtProductName}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- BÖLGESEL İNDİRİM TUTARI -->
                        <TextBlock Text="Bölgesel İndirim Tutarı (₺) *" FontSize="13" FontWeight="Black" Foreground="#0284C7" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <TextBox x:Name="TxtDiscountAmount"
                                     Style="{StaticResource PremiumTextBox}"
                                     FontSize="16"
                                     FontWeight="Bold"
                                     Foreground="#0284C7"
                                     Height="46"/>
                            <TextBlock Text="Örn: 6000"
                                       IsHitTestVisible="False"
                                       Foreground="#94A3B8"
                                       FontSize="14"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtDiscountAmount}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- AÇIKLAMA / NOT -->
                        <TextBlock Text="Not / Açıklama" FontSize="13" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,24">
                            <TextBox x:Name="TxtNote"
                                     Style="{StaticResource PremiumTextBox}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Height="75"/>
                            <TextBlock Text="Örn: Akdeniz bölgesi ekstra 2.000 TL indirim"
                                       IsHitTestVisible="False"
                                       Foreground="#94A3B8"
                                       FontSize="13"
                                       Margin="14,10,0,0"
                                       VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtNote}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- BUTONLAR -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="BtnClear" Click="BtnClear_Click" Style="{StaticResource SecondaryNeutralButton}" Content="Temizle" Width="100" Height="44"/>
                            
                            <Button Grid.Column="1" x:Name="BtnSave" Click="BtnSave_Click" Style="{StaticResource PrimaryGradientButton}" Margin="12,0,0,0" Height="44">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Kaydet / Güncelle" Foreground="White" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>

            <!-- SAĞ PANEL: TANIMLI KAMPANYALAR DATA GRID -->
            <materialDesign:Card Grid.Column="1" UniformCornerRadius="16" Background="White" Padding="24">
                <materialDesign:Card.Effect>
                    <DropShadowEffect BlurRadius="15" Opacity="0.03" ShadowDepth="3" Color="#1E293B"/>
                </materialDesign:Card.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TABLO FİLTRE VE ÖZET -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="280">
                                <TextBox x:Name="TxtFilterList" TextChanged="TxtFilterList_TextChanged"
                                         Style="{StaticResource PremiumTextBox}"
                                         Height="40"/>
                                <TextBlock Text="Listede Ara (Kod/Ad)..."
                                           IsHitTestVisible="False"
                                           Foreground="#94A3B8"
                                           FontSize="13"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtFilterList}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            
                            <Border Background="#E0F2FE" CornerRadius="12" Padding="14,8" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtTotalCount" Text="0 Kayıt" Foreground="#0284C7" FontWeight="Black" FontSize="13"/>
                            </Border>
                        </StackPanel>

                        <Button Grid.Column="1" Click="BtnRefresh_Click" Style="{StaticResource SecondaryNeutralButton}" Width="40" Height="40" Padding="0" ToolTip="Yenile">
                            <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Foreground="#475569"/>
                        </Button>
                    </Grid>

                    <!-- TABLO -->
                    <DataGrid Grid.Row="1" x:Name="GridRegionalCampaigns" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                              SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Resources>
                            <!-- Hangi satır seçilirse seçilsin koyu mavi yerine soft açık mavi zemin ver ve yazıları belirgin tut -->
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E0F2FE"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>

                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                                <Setter Property="FontWeight" Value="Black"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Padding" Value="14,12"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="14,10"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="0">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ürün Kodu" Binding="{Binding ProductCode}" FontWeight="Black" Foreground="#0F172A" Width="110"/>
                            <DataGridTextColumn Header="Ürün Adı" Binding="{Binding ProductName}" FontWeight="Medium" Foreground="#334155" Width="*"/>
                            <DataGridTextColumn Header="Brüt İndirim" Binding="{Binding DiscountAmount, StringFormat={}{0:N2} ₺}" FontWeight="Black" Foreground="#0284C7" Width="125"/>
                            <DataGridTextColumn Header="Net İndirim (%85)" Binding="{Binding NetDiscountAmount, StringFormat={}{0:N2} ₺}" FontWeight="Bold" Foreground="#10B981" Width="135"/>
                            <DataGridTextColumn Header="Not / Açıklama" Binding="{Binding Note}" Foreground="#475569" Width="140"/>
                            <DataGridTextColumn Header="Son Güncelleme" Binding="{Binding UpdatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="#64748B" Width="130"/>
                            <DataGridTemplateColumn Header="İşlemler" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <!-- Düzenle Butonu -->
                                            <Button Click="BtnEditItem_Click" Style="{StaticResource SecondaryNeutralButton}" ToolTip="Düzenle" Width="32" Height="32" Padding="0" Margin="0,0,6,0">
                                                <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Foreground="#0284C7"/>
                                            </Button>
                                            <!-- Sil Butonu -->
                                            <Button Click="BtnDeleteItem_Click" ToolTip="Sil" Width="32" Height="32" Padding="0" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8">
                                                            <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
